# Database connection string (PostgreSQL)
# Format (IPv4 Pooler / Session mode):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
# Or direct IPv6 connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Optional test database connection string
TEST_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/snack_overflow_test

# JWT secret key for signing tokens and session expiration in minutes
JWT_SECRET=replace-this-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
